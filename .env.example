# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# tylko serwer / skrypty (import seeda) - nigdy NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# AI - w produkcji ustawiane jako sekrety Edge Functions:
#   npx supabase secrets set --env-file .env.local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Persony demo bez logowania (persona admina tylko gdy true)
DEMO_MODE=true
